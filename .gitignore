<dialog id="lb"><button aria-label="Đóng" autofocus>×</button><img alt=""></dialog>

<script>
(function(){
var latch=document.querySelector('.latch'),tabs=[].slice.call(latch.querySelectorAll('button')),panels=[].slice.call(document.querySelectorAll('.panel'));
function pick(i,focus){
  latch.dataset.i=i;
  tabs.forEach(function(t,k){t.setAttribute('aria-selected',k===i);t.tabIndex=k===i?0:-1});
  panels.forEach(function(p,k){p.hidden=k!==i;p.classList.toggle('on',k===i)});
  if(focus)tabs[i].focus();
}
tabs.forEach(function(t,i){
  t.addEventListener('click',function(){pick(i)});
  t.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();pick(i?0:1,true)}
  });
});
var lb=document.getElementById('lb'),lbi=lb.querySelector('img');
document.querySelectorAll('[data-open]').forEach(function(im){
  im.addEventListener('click',function(){lbi.src=im.src;lbi.alt=im.alt;if(lb.showModal)lb.showModal()});
});
lb.addEventListener('click',function(e){if(e.target!==lbi)lb.close()});
var main=document.getElementById('top'),cv=document.getElementById('cv'),cvph=document.getElementById('cvph'),ph=document.querySelector('.id img');
if(ph)cvph.src=ph.src;
function route(){
  var on=location.hash==='#cv';
  main.hidden=on;cv.hidden=!on;
  document.title=on?'CV – Nguyễn Hoàng Thiên Kim':'Nguyễn Hoàng Thiên Kim – Portfolio quảng cáo sản phẩm';
  if(on){window.scrollTo(0,0)}
  else{var t=location.hash.length>1&&document.getElementById(location.hash.slice(1));if(t)t.scrollIntoView();else window.scrollTo(0,0)}
}
window.addEventListener('hashchange',route);route();
})();
</script>
</body>
</html>
